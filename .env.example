# ===================================
# Virtual Try-On Configuration
# ===================================

# Choose which provider to use: 'nano-banana' | 'idm-vton' | 'both'
# If 'both', the service will select based on quality mode
TRYON_PROVIDER=both

# -----------------------------------
# Nano Banana (fal.ai) - Fast Mode
# -----------------------------------
# Get your API key from: https://fal.ai/dashboard/keys
FAL_API_KEY=your_fal_api_key_here

# Optional: Custom endpoint (leave empty for default)
FAL_ENDPOINT=

# -----------------------------------
# IDM-VTON (Replicate) - Quality Mode
# -----------------------------------
# Get your API token from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_token_here

# Optional: Custom model version (leave empty for default)
REPLICATE_MODEL_VERSION=

# -----------------------------------
# Service Configuration
# -----------------------------------

# Default quality mode: 'fast' | 'high'
DEFAULT_QUALITY=fast

# Enable automatic fallback to alternative provider
ENABLE_FALLBACK=true

# Enable result caching
ENABLE_CACHE=true

# Cache TTL in days
CACHE_TTL_DAYS=30

# -----------------------------------
# Development
# -----------------------------------

# Node environment
NODE_ENV=development

# Log level: 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL=debug

# -----------------------------------
# Optional: Analytics & Monitoring
# -----------------------------------

# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# Analytics provider (optional)
ANALYTICS_PROVIDER=
ANALYTICS_KEY=
